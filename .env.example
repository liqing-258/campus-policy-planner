# ============================================================
# 知校 · 环境变量模板
# 用法：复制为 .env 后按需填写。.env 已在 .gitignore 中，不会入库。
#      Windows:  copy .env.example .env
#      macOS/Linux: cp .env.example .env
# 说明：除 JWT_SECRET 外全部可为空；模型相关留空则自动进入降级模式。
# ============================================================

# ---------- 运行 ----------
APP_ENV=dev
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=5000

# ---------- 数据库 ----------
# 默认 SQLite（零安装）。切换 PostgreSQL 时改这一行即可，代码无需改动。
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/campus_policy

# ---------- 鉴权（必填）----------
# 生成方法：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=please-replace-with-a-random-32-byte-hex
JWT_EXPIRE_MINUTES=720

# ---------- 文件 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# ---------- 模型接入（全部可留空 → 降级模式）----------
# 兼容 OpenAI 协议的任意供应商：填 base_url + key + model 即可。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_RETRY=1

# Embedding（留空则仅 BM25 检索）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------- 检索参数 ----------
RAG_TOP_K=6
# 拒答阈值（M4 使用，比对归一化分数；M3 的原始 BM25 分不可直接作阈值）
RAG_MIN_SCORE=0.35
# 检索粗筛：命中的查询词项占比低于此值直接判"主题不相关"。
# 0.6 仅在 3 片段 toy 语料上观察得到，未用评测集校准。
RAG_MIN_COVERAGE=0.6
CHUNK_SIZE=600
CHUNK_OVERLAP=80
# 有效文本阈值（低于此字符数判 empty）
MIN_TEXT_CHARS=50
# PDF 每页平均字符数低于此值提示"疑似扫描件"
SCANNED_PAGE_CHAR_THRESHOLD=20

# ---------- 限流（N 次/分钟/用户）----------
RATE_LIMIT_PER_MINUTE=20

# ---------- 演示模式 ----------
# true = 前端顶部常驻"演示数据"标识
DEMO_BANNER=true
