# ============================================================
# 知校 · 环境变量模板
# 用法：复制为 .env 后按需填写。.env 已在 .gitignore 中，不会入库。
#      Windows:  copy .env.example .env
#      macOS/Linux: cp .env.example .env
# 说明：除 JWT_SECRET 外全部可为空；模型相关留空则自动进入降级模式。
# ============================================================

# ---------- 运行 ----------
APP_ENV=dev
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=5000

# ---------- 数据库 ----------
# 默认 SQLite（零安装）。切换 PostgreSQL 时改这一行即可，代码无需改动。
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/campus_policy

# ---------- 鉴权（必填）----------
# 生成方法：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=please-replace-with-a-random-32-byte-hex
JWT_EXPIRE_MINUTES=720

# ---------- 文件 ----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# ---------- 模型接入（全部可留空 → 降级模式）----------
# 兼容 OpenAI 协议的任意供应商：填 base_url + key + model 即可。
# 本项目 M4 实测可用：LLM_BASE_URL=https://api.deepseek.com/v1 / LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_RETRY=1
# 推理模型的 reasoning_tokens 会先占用这份预算，给太小会导致 content 返回空
LLM_MAX_TOKENS=2500

# Embedding（留空则仅 BM25 检索）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---------- 检索参数 ----------
RAG_TOP_K=6
# 分数阈值：**当前不参与任何决策**（保留项）。M3 已实测原始 BM25 分不可作阈值，
# M4 的拒答改由下面的覆盖率闸门 + 模型自评两段完成，此项仅为兼容旧配置保留。
RAG_MIN_SCORE=0.35
# 检索粗筛：命中的查询词项占比低于此值直接判"主题不相关"。
# 0.35 由 M4 的 24 条评测集 5 点扫描定标（0.15/0.25/0.35/0.5），曲线非单调；
# 选 0.35 是为"更保守 + 距 0.5 留余量"，不是因为它分数最高。详见 docs/60-交付/运行说明.md §4.8。
RAG_MIN_COVERAGE=0.35
CHUNK_SIZE=600
CHUNK_OVERLAP=80
# 有效文本阈值（低于此字符数判 empty）
MIN_TEXT_CHARS=50
# PDF 每页平均字符数低于此值提示"疑似扫描件"
SCANNED_PAGE_CHAR_THRESHOLD=20

# ---------- 限流（N 次/分钟/用户）----------
RATE_LIMIT_PER_MINUTE=20

# ---------- 演示模式 ----------
# true = 前端顶部常驻"演示数据"标识
DEMO_BANNER=true
