# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# ---------- Node ----------
node_modules/
frontend/dist/
.vite/
*.local

# ---------- 密钥与本地配置（严禁提交）----------
.env
.env.local
*.pem
*.key

# ---------- 运行期数据（不入库）----------
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/
data/backups/
logs/
*.log

# ---------- 工具与 IDE ----------
.workbuddy/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------- 构建产物 ----------
dist/
build/
# M7：PyInstaller 中间目录（每次构建带时间戳，留档可回退，但不入库）
.build/
# 根目录误跑 npm 会生成一个空锁文件（真正的锁文件在 frontend/）
/package-lock.json
*.spec

# ---------- 例外：演示数据必须入库 ----------
!demo/**
!demo/

# M5 起：演示库手工备份（仅本机保留，不入库）
data/*.db.bak*

# vite 构建时在 frontend/ 下丢的临时配置文件（--outDir 跑完不自动清）
frontend/vite.config.ts.timestamp-*
